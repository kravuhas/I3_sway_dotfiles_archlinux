set $mod Mod4
# Config for sway
#
# Read `man 5 sway` for a complete reference.

# user config directory
include $HOME/.config/sway/config.d/*
include /etc/sway/outputs/*

# only enable this if every app you use is compatible with wayland
# xwayland disable
#output * bg ~/Pictures/wallpapers/wallhaven-k77ez7.png fill
include ~/.config/sway/lain.conf

# --- swayfx-setup ---
corner_radius 12
smart_corner_radius enable
default_border pixel 2
gaps inner 8
gaps outer 4

exec swaync
bindsym $mod+Shift+n exec swaync-client -t -sw
# --- fim swayfx-setup ---

# Arquivos locais adicionais (inclui configuração de compartilhamento de tela)
include ~/.config/sway/config.d/*.conf
# >>> setup-sway >>>
# Exporta o ambiente para o systemd/D-Bus: ESSENCIAL para o portal de screencast
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME

# Autostart
exec nm-applet --indicator
exec blueman-applet
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec kanshi

# Atalhos
# bindsym Mod4+space exec /home/felpz/.local/bin/screenshot region
# <<< setup-sway <<<

# >>> efeitos-swayfx >>>
blur enable
blur_passes 3
blur_radius 5
shadows enable
shadow_blur_radius 20
shadow_color #000000AA
default_dim_inactive 0.08
layer_effects "waybar" blur enable; shadows enable
layer_effects "notifications" blur enable; shadows enable
layer_effects "launcher" blur enable; shadows enable
# <<< efeitos-swayfx <<<


# >>> rice-swappy >>>
bindsym Mod4+Ctrl+space exec sh -c 'grim -g "$(slurp)" - | swappy -f -'
# <<< rice-swappy <<<

# >>> rice-effects >>>
# <<< rice-effects <<<

# >>> atalhos de screenshot (setup-print-sway) >>>
# Print: seleciona área e copia para a área de transferência
unbindsym Print
bindsym Print exec grim -g "$(slurp)" - | wl-copy

# Super + Print: seleciona área e salva em arquivo
bindsym $mod+Print exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png

# Super + Shift + Print: tela inteira salva em arquivo
bindsym $mod+Shift+Print exec grim ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png

# Super + Space: seleciona área e salva em arquivo
bindsym $mod+space exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png
# <<< fim dos atalhos de screenshot <<<

# >>> cursor ralsei (setup-extras-sway) >>>
seat * xcursor_theme ralseiCursor 24
exec_always gsettings set org.gnome.desktop.interface cursor-theme 'ralseiCursor'
exec_always gsettings set org.gnome.desktop.interface cursor-size 24
# <<< fim cursor ralsei <<<
